# ─── Deployment ────────────────────────────────────────────────
# External IP or hostname attackers will hit (used in deception banners).
HONEY_EXTERNAL_IP=0.0.0.0
HONEY_DEPLOYMENT_ID=hp-prod-01

# ─── Service ports (host side) ─────────────────────────────────
SSH_PORT=2222
HTTP_PORT=8080

# ─── SSH deception profile ─────────────────────────────────────
# Rotates on every container restart unless pinned.
# Examples: "OpenSSH_8.9p1 Ubuntu-3ubuntu0.1", "OpenSSH_7.4"
SSH_BANNER=auto
SSH_HOSTNAME=auto
SSH_FAKE_USERS=root:toor,admin:admin,pi:raspberry,ubuntu:ubuntu

# ─── HTTP deception profile ────────────────────────────────────
HTTP_SERVER_HEADER=auto
HTTP_DEFAULT_PAGE=apache

# ─── ELK ───────────────────────────────────────────────────────
ELASTIC_VERSION=8.13.4
ELASTIC_PASSWORD=changeme
KIBANA_PORT=5601

# ─── Intel module (web UI on this port) ────────────────────────
INTEL_PORT=8090

# ─── Anti-detection ────────────────────────────────────────────
# Jitter range (ms) added to responses to defeat timing fingerprints
RESPONSE_JITTER_MIN=10
RESPONSE_JITTER_MAX=120

# Disable verbose error strings that Censys scanners match on
DECEPTION_STRICT=true
